---
// §5.17: the 6 most recent copies of a file (or video + poster), each restorable; not painted when there are none.
import Icon from './Icon.astro';
import Chip from './Chip.astro';
import * as fmt from '../../lib/format.mjs';
interface Props { item: any; csrf: string }
const { item: slot, csrf } = Astro.props;
const list = slot.backups ?? [];
---
{list.length > 0 && (
  <details class="copies">
    <summary class="btn btn--quiet">Versiones anteriores ({list.length}) <Icon name="chevron-down" size={14} class="chev" /></summary>
    <ol>
      {list.map((b, i) => {
        const when = fmt.dateTime(b.ts);
        const chip = slot.kind === 'video' ? (b.role === 'poster' ? 'Portada' : 'Video') : i === 0 ? 'La anterior' : null;
        return (
          <li>
            {chip ? <Chip>{chip}</Chip> : <span />}
            <span class="copies__when">Estuvo en la web hasta el {when} · {fmt.size(b.size)}</span>
            <form method="post" action="/restore" data-confirm data-confirm-icon="rotate-ccw" data-confirm-title={`¿Volver a esta versión de «${slot.label}»?`}
              data-confirm-text={`El archivo que está ahora en la web se cambiará por el que estuvo hasta el ${when.replace(/\.$/, '')}. El actual quedará en «Versiones anteriores».`}
              data-confirm-ok="Sí, volver a esta versión">
              <input type="hidden" name="_csrf" value={csrf} /><input type="hidden" name="slot" value={slot.id} />
              <input type="hidden" name="file" value={b.file} />
              <button class="btn btn--outline btn--sm" type="submit"><Icon name="rotate-ccw" size={16} />Volver a esta<span class="sr-only"> versión del {when}</span></button>
            </form>
          </li>
        );
      })}
    </ol>
    <p class="hint">Volver a una versión guarda la actual, así que también se puede deshacer.</p>
  </details>
)}
