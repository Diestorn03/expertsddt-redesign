---
// §5.22: the one confirm dialog; its texts come from the data-confirm-* attributes of the form that opens it. Also holds the
// icon <template>s the bundle clones (so no SVG path is duplicated in the script) and the toast region (§5.23).
import Icon from './Icon.astro';
const ICONS = ['check', 'info', 'alert-triangle', 'alert-circle', 'x', 'film', 'file-text', 'package', 'image-off', 'rotate-ccw'];
---
<dialog class="dlg" id="confirm" aria-labelledby="dlg-t" aria-describedby="dlg-d">
  <form method="dialog" class="dlg__in">
    <button class="dlg__x" value="cancel" aria-label="Cerrar"><Icon name="x" size={18} /></button>
    <span class="tile tile--48" data-dlg-icon><Icon name="package" size={20} /></span>
    <h2 id="dlg-t"></h2><p id="dlg-d"></p><div class="well" data-dlg-detail hidden></div>
    <div class="dlg__act"><button class="btn btn--outline" value="cancel" autofocus>No, volver</button>
      <button class="btn btn--primary" value="ok" data-dlg-ok></button></div>
  </form>
</dialog>
<template id="icons">{ICONS.map((n) => <span data-icon={n}><Icon name={n} size={16} /></span>)}</template>
<div class="toasts" aria-live="polite"></div>
<p id="sr-status" class="sr-only" role="status" aria-live="polite"></p>
