          }
        ],
        [
          {
            "node": "Fila en Google Sheets",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Fila DDT Xchange",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Correo a Experts DDT": {
      "main": [
        [
          {
            "node": "Responder OK",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fila en Google Sheets": {
      "main": [
        [
          {
            "node": "Responder OK",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fila DDT Xchange": {
      "main": [
        [
          {
            "node": "Responder OK",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
