# Experts DDT — Hostinger (LiteSpeed / Apache). Replaces the WordPress .htaccess at cutover.
# Single source of truth for redirects, caching and security headers. Test with: curl -I https://expertsddt.com/<old-url>

Options -Indexes
ErrorDocument 404 /404.html
ErrorDocument 410 /404.html
DirectoryIndex index.html index.php

# The client portal lives in public_html/portal (portal.expertsddt.com) and inherits this file: every rule below applies
# to expertsddt.com only (DDT_SITE), so the portal keeps its own redirects, caching and security headers.
SetEnvIf Host "^(www\.|staging\.)?expertsddt\.com$" DDT_SITE

<IfModule mod_rewrite.c>
RewriteEngine On

# Any other host (portal.expertsddt.com, staging): not this site's rules
RewriteCond %{HTTP_HOST} !^(www\.|staging\.)?expertsddt\.com$ [NC]
RewriteRule ^ - [L]

# ---- HTTPS + canonical host (no www) ---------------------------------------
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://expertsddt.com%{REQUEST_URI} [L,R=301]

# ---- Old WordPress files people may have bookmarked or shared ----------------
RewriteRule ^wp-content/uploads/2026/09/services-and-fees-experts-ddt\.pdf$ /downloads/services-and-fees-experts-ddt.pdf [L,R=301]
RewriteRule ^wp-content/uploads/.*exocad-implant-libraries.*\.zip$ /exocad-libraries/ [NC,L,R=301]

# ---- Old WordPress / WooCommerce URLs -> new site ---------------------------
RewriteRule ^libraries/?$ /exocad-libraries/ [L,R=301]
# Shop = Shopify (shop.expertsddt.com). Old WooCommerce URLs go to the same product/collection there.
# Handles mirror the store catalogue; scripts/check-shop.mjs checks each one before every production deploy.
RewriteRule ^producto/vision-x-extraoral-photogrammetry-system/?$ https://shop.expertsddt.com/products/vision-x-extraoral-photogrammetry [L,R=301]
RewriteRule ^producto/5-0-facial-scanning-technology-by-fernando-polanco/?$ https://shop.expertsddt.com/products/facial-scanning-5-0-fernando-polanco [L,R=301]
RewriteRule ^producto/titanium-fp1-healing-abutment-for-surgery-patent-pending/?$ https://shop.expertsddt.com/products/fp1-healing-abutment [L,R=301]
RewriteRule ^producto/titanium-fp3-healing-abutment-for-surgery-patent-pending/?$ https://shop.expertsddt.com/products/fp3-healing-abutment [L,R=301]
RewriteRule ^producto/templates-package/?$ https://shop.expertsddt.com/products/teeth-in-occlusion-virtual-gingiva-libraries [L,R=301]
RewriteRule ^producto/3d-aesthetic-guidelines-smile-creator-8mm-dr-fernando-polanco/?$ https://shop.expertsddt.com/products/3d-aesthetic-guidelines-smile-creator-8mm [L,R=301]
RewriteRule ^producto/masterclass-master-the-virtual-teeth-in-occlusion-libraries/?$ https://shop.expertsddt.com/products/exocad-training-teeth-virtual-gingiva-libraries [L,R=301]
RewriteRule ^producto(/.*)?$ https://shop.expertsddt.com/collections/all [L,R=301]
RewriteRule ^categoria-producto/cursos/?$ https://shop.expertsddt.com/collections/courses [L,R=301]
RewriteRule ^categoria-producto/plantillas/?$ https://shop.expertsddt.com/collections/templates [L,R=301]
RewriteRule ^categoria-producto(/.*)?$ https://shop.expertsddt.com/collections/all [L,R=301]
RewriteRule ^(carrito|finalizar-compra)/?$ https://shop.expertsddt.com/cart [L,R=301]
RewriteRule ^shop/?$ https://shop.expertsddt.com/ [L,R=301]
RewriteRule ^pricing-2/?$ /courses/ [L,R=301]
RewriteRule ^register/?$ https://portal.expertsddt.com/signup [L,R=301]
RewriteRule ^(login|mi-cuenta|account|password-reset)/?$ https://portal.expertsddt.com/login [L,R=301]
RewriteRule ^(pagina-ejemplo/?|category/.*)$ / [L,R=301]

# Service posts published in Nov 2025 -> matching section of /services/
RewriteRule ^2025/11/27/design/?$ /services/#design [NE,L,R=301]
RewriteRule ^2025/11/18/hola-mundo/?$ /services/#manufacturing [NE,L,R=301]
RewriteRule ^2025/11/27/final-product-manufacturing/?$ /services/#manufacturing [NE,L,R=301]
RewriteRule ^2025/11/27/cutting-edge-technology/?$ /services/#scanning [NE,L,R=301]
RewriteRule ^2025/11/27/training/?$ /services/#training [NE,L,R=301]
RewriteRule ^2025/11/27/(support|implementation)/?$ /services/#support [NE,L,R=301]
RewriteRule ^2025/11/27/(components|customized-workflows)/?$ /services/ [L,R=301]

# Old sitemaps
RewriteRule ^(sitemap_index|page-sitemap|post-sitemap|product-sitemap|category-sitemap|product_cat-sitemap|product_tag-sitemap|author-sitemap)\.xml$ /sitemap-index.xml [L,R=301]

# WordPress internals no longer exist
RewriteRule ^(wp-admin|wp-login\.php|xmlrpc\.php|wp-json|wp-includes|wp-content|feed|comments)(/.*)?$ - [G,L]

# Flag hashed build assets for the long-cache header below
RewriteRule ^_astro/ - [E=IS_ASTRO:1]

# Never serve dotfiles or source/maps
RewriteRule (^|/)\.(?!well-known) - [F,L]
</IfModule>

# ---- Compression & caching ---------------------------------------------------
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/plain application/xml
</IfModule>

<IfModule mod_expires.c>
ExpiresActive On
ExpiresDefault "access plus 1 hour"
ExpiresByType text/html "access plus 0 seconds"
ExpiresByType application/xml "access plus 1 hour"
</IfModule>

<IfModule mod_headers.c>
# Images, video, fonts, JS and CSS: one day (the content panel may replace a file under the same name)
<FilesMatch "\.(js|css|woff2?|webp|png|jpg|jpeg|svg|mp4|ico)$">
Header set Cache-Control "public, max-age=86400" env=DDT_SITE
</FilesMatch>
# Only /_astro/ files carry a content hash in their name, so those can be cached for a year
Header set Cache-Control "public, max-age=31536000, immutable" env=IS_ASTRO
<FilesMatch "\.(html|xml|txt)$">
Header set Cache-Control "no-cache" env=DDT_SITE
</FilesMatch>
# Downloads may be replaced under the same name (guide PDF): revalidate
<FilesMatch "\.(pdf|zip)$">
Header set Cache-Control "no-cache" env=DDT_SITE
</FilesMatch>

# ---- Security headers --------------------------------------------------------
Header always set X-Content-Type-Options "nosniff" env=DDT_SITE
Header always set X-Frame-Options "SAMEORIGIN" env=DDT_SITE
Header always set Referrer-Policy "strict-origin-when-cross-origin" env=DDT_SITE
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" env=DDT_SITE
Header always set Strict-Transport-Security "max-age=31536000" env=DDT_SITE
Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups" env=DDT_SITE
# Inline scripts/styles are used by the theme bootstrap and analytics, so 'unsafe-inline' stays until they are hashed.
# Everything else is an allow-list: tighten connect-src with the real Apps Script hosts before launch.
Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; font-src 'self' data:; img-src 'self' data: https://www.google-analytics.com https://*.googletagmanager.com; media-src 'self'; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com https://script.google.com https://script.googleusercontent.com; frame-src https://calendar.google.com https://www.youtube-nocookie.com; object-src 'none'; base-uri 'self'; form-action 'self' https://script.google.com; frame-ancestors 'self'; upgrade-insecure-requests" env=DDT_SITE
</IfModule>
