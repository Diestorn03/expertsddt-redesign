# Copy to .env (local) or set as environment variables in Vercel/Netlify. All optional.

# Google Analytics 4 measurement ID. Loads only after the visitor accepts cookies.
PUBLIC_GA_ID=

# n8n webhook that receives the contact form as JSON {name,email,clinic,message,lang,page}.
# Without it the form falls back to opening the visitor's email client.
PUBLIC_N8N_FORM_WEBHOOK=

# n8n Chat Trigger webhook URL for "Apex", the digital concierge (@n8n/chat widget).
# Without it the floating button links to the contact page.
PUBLIC_N8N_CHAT_WEBHOOK=

# Google Calendar appointment schedule embed URL (Share → Embed). Shown on /contact/.
# Example: https://calendar.google.com/calendar/appointments/schedules/AcZssZ…?gv=true
PUBLIC_GCAL_EMBED=

# Shopify store URL. "Store" and "Add to cart" links point here when set.
PUBLIC_SHOP_URL=

# WhatsApp number in international format without "+" (floating button).
PUBLIC_WHATSAPP=15106760418
