---
import Base from '../layouts/Base.astro';
import Cta from '../components/Cta.astro';
import { useI18n } from '../i18n/index.js';
const { t, href, asset } = useI18n(Astro);
const s = t.pages.store;
const shop = import.meta.env.PUBLIC_SHOP_URL;
const catHref = [shop || href('/courses/'), shop || 'https://expertsddt.com/store/', '#products'];
const buy = shop || 'https://expertsddt.com/store/';
// real renders of the teeth-in-occlusion libraries and the Exocad course recording (client assets)
const visuals = [asset('/img/lib-occlusion.webp'), asset('/img/lib-natural.webp'), asset('/video/exocad-denture.webp')];
---
<Base title={t.meta.store}>
  <section class="page-hero" data-nav-solid-from data-scene>
    <div class="grid-bg" aria-hidden="true"></div>
    <div class="wrap stack">
      <span class="eyebrow" data-reveal="up">{s.eyebrow}</span>
      <h1 class="h-display" data-split="words">{s.title}</h1>
      <p class="lead" data-reveal="up" data-delay=".3">{s.lead}</p>
    </div>
  </section>

  <section class="section" data-scene>
    <div class="wrap">
      <div class="grid-3" data-stagger=".1">
        {s.cats.map((c, i) => (
          <a class="cat card" href={catHref[i]} data-tilt target={catHref[i].startsWith('http') ? '_blank' : undefined} rel="noopener">
            <span class="pill">{c.n}</span>
            <h2 class="h-lg">{c.t}</h2>
            <p>{c.d}</p>
            <span class="cat__cta">{s.browse} <span class="arrow">→</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section id="products" class="section section--mist" data-scene>
    <div class="wrap">
      <div class="stack" style="margin-bottom:2.5rem" data-reveal-scope>
        <span class="eyebrow" data-reveal="up">{s.featured}</span>
        <h2 class="h-xl" data-split="lines">{s.bestTitle} <span class="underline-accent">{s.bestAccent}</span></h2>
        <p class="note" data-reveal="up" data-delay=".2">{s.shopifyNote}</p>
      </div>
      <div class="products">
        {s.products.map((p, i) => (
          <article class="product card" data-reveal="up" data-delay={i * .1}>
            <div class="product__visual" aria-hidden="true"><img src={visuals[i]} alt="" loading="lazy" /><span>{p.cat}</span></div>
            <div class="stack">
              <span class="pill">{s.sale}</span>
              <h3>{p.t}</h3>
              <p>{p.d}</p>
              <div class="cta-row">
                <span class="price"><s>{p.was}</s>{p.now}</span>
                <a class="btn btn--outline" href={buy} target="_blank" rel="noopener">{s.addToCart}</a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <Cta title={s.ctaTitle} />
</Base>

<style>
  .cat { display: grid; gap: .8rem; align-content: start; min-height: 240px; transition: box-shadow .4s; }
  .cat:hover { box-shadow: 0 30px 60px -28px rgba(29,50,115,.5); }
  .cat__cta { margin-top: auto; color: var(--blue); font-weight: 600; }
  .products { display: grid; gap: 1.5rem; }
  .product { display: grid; grid-template-columns: 220px 1fr; gap: 2rem; align-items: center; }
  .product__visual { aspect-ratio: 1; border-radius: 16px; background: #4b3f8f; position: relative; overflow: hidden; }
  .product__visual img { width: 100%; height: 100%; object-fit: cover; transition: transform .8s var(--ease-out); }
  .product:hover .product__visual img { transform: scale(1.05); }
  .product__visual span { position: absolute; left: .7rem; bottom: .7rem; padding: .3rem .65rem; border-radius: 999px; background: rgba(10,26,58,.75); color: #fff; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; font-size: .66rem; }
  .product h3 { font-size: 1.3rem; }
  @media (max-width: 700px) { .product { grid-template-columns: 1fr; gap: 1.2rem; } .product__visual { aspect-ratio: 16/9; } .cat { min-height: 0; } }
</style>
