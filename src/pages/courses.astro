---
import Base from '../layouts/Base.astro';
import Cta from '../components/Cta.astro';
import { useI18n } from '../i18n/index.js';
const { t, asset } = useI18n(Astro);
const c = t.pages.courses;
const shop = import.meta.env.PUBLIC_SHOP_URL || 'https://expertsddt.com/courses/';
---
<Base title={t.meta.courses}>
  <section class="page-hero courses-hero" data-nav-solid-from data-scene>
    <div class="grid-bg" aria-hidden="true"></div>
    <div class="wrap stack courses-hero__inner">
      <span class="eyebrow" data-reveal="up">{c.eyebrow}</span>
      <h1 class="h-display" data-split="words">{c.title}</h1>
      <p class="lead" data-reveal="up" data-delay=".3">{c.lead}</p>
      <div class="cta-row" data-reveal="up" data-delay=".45">
        <a class="btn btn--primary" href="#catalog">{c.join} <span class="arrow">→</span></a>
      </div>
    </div>
    <div class="courses-hero__ring" aria-hidden="true" data-parallax="0.3"></div>
  </section>

  <section id="catalog" class="section" data-scene>
    <div class="wrap">
      <div class="stack" style="max-width:720px;margin-bottom:2.5rem" data-reveal-scope>
        <span class="eyebrow" data-reveal="up">{c.catalogEyebrow}</span>
        <h2 class="h-xl" data-split="lines">{c.catalogTitle} <span class="underline-accent">{c.catalogAccent}</span>.</h2>
      </div>
      <article class="course card" data-reveal="drop" data-tilt>
        <div class="course__media">
          <video autoplay muted loop playsinline preload="metadata" src={asset('/video/smile-preview.mp4')}></video>
          <span class="pill">{c.sale}</span>
        </div>
        <div class="course__body stack">
          <span class="eyebrow">{c.courseEyebrow}</span>
          <h3 class="h-lg">{c.courseTitle}</h3>
          <p>{c.courseText}</p>
          <ul class="course__meta">{c.meta.map((m) => <li>{m}</li>)}</ul>
          <div class="cta-row">
            <span class="price"><s>{c.was}</s>{c.now}</span>
            <a class="btn btn--primary" href={shop} target="_blank" rel="noopener">{c.addToCart} <span class="arrow">→</span></a>
          </div>
        </div>
      </article>
    </div>
  </section>

  <Cta title={c.ctaTitle} />
</Base>

<style>
  .courses-hero__inner { text-align: center; justify-items: center; }
  .courses-hero__inner .cta-row { justify-content: center; }
  .courses-hero__ring { position: absolute; right: -10vw; top: -10vw; width: 40vw; aspect-ratio: 1; border-radius: 50%; border: 1px solid rgba(255,255,255,.12); box-shadow: inset 0 0 0 40px rgba(4,107,210,.15); z-index: -1; }
  .course { display: grid; grid-template-columns: 1.1fr 1fr; gap: 2.5rem; padding: 1.2rem; overflow: hidden; }
  .course__media { position: relative; border-radius: 16px; overflow: hidden; min-height: 320px; }
  .course__media video { width: 100%; height: 100%; object-fit: cover; }
  .course__media .pill { position: absolute; top: 1rem; left: 1rem; background: var(--surface); }
  .course__body { padding: 1.5rem 1.5rem 1.5rem 0; align-content: center; }
  .course__meta { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: .5rem; align-items: flex-start; }
  .course__meta li { font-size: .8rem; font-weight: 600; padding: .4rem .8rem; border-radius: 999px; background: var(--mist); color: var(--ink); }
  @media (max-width: 960px) { .course { grid-template-columns: 1fr; padding: .8rem; } .course__body { padding: .8rem; } .course__media { min-height: 220px; aspect-ratio: 16 / 10; } }
</style>
