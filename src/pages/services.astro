---
import Base from '../layouts/Base.astro';
import Cta from '../components/Cta.astro';

const rows = [
  { id: 'design', n: '01', t: 'Premium design services', p: 'High-level designs for complex cases such as All-on-X from start to finish, plus dentures, overdentures, bars, bridges and FMR crowns, veneers and surgical guides.', cta: 'Book your session now', video: '/video/smile-design.mp4', tags: ['All-on-X', 'Dentures', 'Bars & bridges', 'Veneers', 'Surgical guides'] },
  { id: 'manufacturing', n: '02', t: '3D printing and final manufacturing', p: 'Full arch production via 3D printing, PMMA, and final Zirconia. Creation of models or full-arch prostheses using 3D printing technology.', cta: 'Schedule a consultation', panel: true, tags: ['3D printing', 'PMMA', 'Zirconia', 'Models'] },
  { id: 'scanning', n: '03', t: 'Cutting-edge 3D facial scanning technology', p: 'Incorporation of advanced facial scanning technology for higher precision in diagnosis and planning. Capture facial, bite and denture scans in under 10 seconds and save up to 80% of chair time.', cta: 'Book your session now', img: '/img/design-services.webp', tags: ['Facial scanning 5.0', 'Photogrammetry', 'CBCT'] },
  { id: 'training', n: '04', t: 'Specialized training', p: 'Comprehensive training on the use of intraoral and facial scanning technology, as well as Exocad, 3D printing, milling, and finishing; essential for achieving fast turnaround times.', cta: 'Schedule a consultation', img: '/img/training-main.webp', tags: ['Intraoral scanning', 'Exocad', 'Milling', 'Finishing'] },
  { id: 'support', n: '05', t: 'Consulting visits & support', p: 'We offer local visits to offices in Florida to streamline the process of treatment and patient care. You will also receive specialized expert support exactly when you need it.', cta: 'Book your session now', img: '/img/training.webp', tags: ['On-site visits', 'Florida', 'On-demand support'] },
];
---
<Base title="Services" description="Premium design services, 3D printing, facial scanning, specialized training and consulting visits by Experts DDT.">
  <section class="page-hero" data-nav-solid-from data-scene>
    <div class="grid-bg" aria-hidden="true"></div>
    <div class="wrap stack">
      <span class="eyebrow" data-reveal="up">Services</span>
      <h1 class="h-display" data-split="words">Premium services for the fully digital practice.</h1>
      <p class="lead" data-reveal="up" data-delay=".3">From the first scan to the final Zirconia. Design, manufacturing, technology, training and support, delivered by Fernando Polanco DDT experts.</p>
      <nav class="jump" aria-label="Services on this page" data-stagger=".06">
        {rows.map((r) => <a href={`#${r.id}`}><span>{r.n}</span>{r.t}</a>)}
      </nav>
    </div>
  </section>

  {rows.map((r, i) => (
    <section id={r.id} class={`section row ${i % 2 ? 'row--flip' : ''} ${i % 2 ? 'section--mist' : ''}`} data-scene>
      <div class="wrap grid-2">
        <div class="row__media" data-reveal={i % 2 ? 'right' : 'left'}>
          {r.video && <video class="img-frame" autoplay muted loop playsinline preload="metadata" src={r.video}></video>}
          {r.img && <div class="img-frame"><img src={r.img} alt="" loading="lazy" /></div>}
          {r.panel && (
            <div class="row__panel img-frame" aria-hidden="true">
              <span>PMMA</span><span>Zirconia</span><span>3D print</span>
              <b>Full arch</b>
            </div>
          )}
        </div>
        <div class="row__copy stack" data-reveal-scope>
          <span class="row__num" data-reveal="up">{r.n}</span>
          <h2 class="h-xl" data-split="lines">{r.t}</h2>
          <p class="lead" data-reveal="up" data-delay=".15">{r.p}</p>
          <ul class="tags" data-stagger=".05">{r.tags.map((t) => <li>{t}</li>)}</ul>
          <div data-reveal="up" data-delay=".25"><a class="btn btn--primary" href="/contact">{r.cta} <span class="arrow">→</span></a></div>
        </div>
      </div>
    </section>
  ))}

  <Cta title="Let’s design your <span class='cta__accent'>next case</span> together." />
</Base>

<style>
  .jump { display: flex; flex-wrap: wrap; gap: .6rem; margin-top: 1rem; }
  .jump a { display: inline-flex; align-items: center; gap: .6rem; padding: .6rem 1rem; border-radius: 999px; border: 1px solid rgba(255,255,255,.18); font-size: .85rem; font-weight: 500; transition: background .3s, border-color .3s; }
  .jump a span { color: #6fb6ff; font-weight: 700; }
  .jump a:hover { background: rgba(255,255,255,.1); border-color: #fff; }
  .row--flip .row__media { order: 2; }
  .row__media .img-frame { aspect-ratio: 4 / 3; }
  .row__media video { width: 100%; height: 100%; object-fit: cover; }
  .row__num { font-size: 4rem; font-weight: 800; line-height: .8; color: transparent; -webkit-text-stroke: 1.5px rgba(4,107,210,.4); }
  .row__panel { background: var(--grad); color: #fff; display: grid; place-content: center; gap: .6rem; text-align: center; padding: 2rem; }
  .row__panel span { font-size: .8rem; letter-spacing: .3em; text-transform: uppercase; opacity: .8; }
  .row__panel b { font-size: clamp(2.5rem, 6vw, 4.5rem); font-weight: 800; letter-spacing: -.03em; line-height: 1; margin-top: 1rem; }
  .tags { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: .5rem; }
  .tags li { padding: .4rem .8rem; border-radius: 999px; background: rgba(4,107,210,.08); color: var(--blue); font-size: .8rem; font-weight: 600; }
  @media (max-width: 960px) { .row--flip .row__media { order: 0; } }
</style>
