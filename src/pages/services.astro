---
import Base from '../layouts/Base.astro';
import Cta from '../components/Cta.astro';
import { useI18n } from '../i18n/index.js';
const { t, href, asset } = useI18n(Astro);
const s = t.pages.services;
// client assets: Exocad smile design, facial-scanner software, clinic intraoral scanning, real team photo
const media = [
  { video: asset('/video/exocad-smile.mp4'), poster: asset('/video/exocad-smile.webp') },
  { panel: true },
  { video: asset('/video/scan-ui.mp4'), poster: asset('/video/scan-ui.webp'), square: true }, // two stacked scan views: a 4:3 crop cuts both
  { video: asset('/video/clinic-scan.mp4'), poster: asset('/video/clinic-scan.webp') },
  { img: asset('/img/team.webp') },
];
---
<Base title={t.meta.services}>
  <section class="page-hero" data-nav-solid-from data-scene>
    <div class="grid-bg" aria-hidden="true"></div>
    <div class="wrap stack">
      <span class="eyebrow" data-reveal="up">{s.eyebrow}</span>
      <h1 class="h-display" data-split="words">{s.title}</h1>
      <p class="lead" data-reveal="up" data-delay=".3">{s.lead}</p>
      <nav class="jump" aria-label={s.jumpLabel} data-stagger=".06">
        {s.rows.map((r) => <a href={`#${r.id}`}><span>{r.n}</span>{r.t}</a>)}
      </nav>
    </div>
  </section>

  {s.rows.map((r, i) => (
    <section id={r.id} class={`section row ${i % 2 ? 'row--flip section--mist' : ''}`} data-scene>
      <div class="wrap grid-2">
        <div class="row__media" data-reveal={i % 2 ? 'right' : 'left'}>
          {media[i].video && <video class={`img-frame ${media[i].square ? 'img-frame--square' : ''}`} autoplay muted loop playsinline preload="metadata" poster={media[i].poster} src={media[i].video}></video>}
          {media[i].img && <div class="img-frame"><img src={media[i].img} alt="" loading="lazy" /></div>}
          {media[i].panel && (
            <div class="row__panel img-frame" aria-hidden="true">
              {s.panel.tags.map((x) => <span>{x}</span>)}
              <b>{s.panel.big}</b>
            </div>
          )}
        </div>
        <div class="row__copy stack" data-reveal-scope>
          <span class="row__num" data-reveal="up">{r.n}</span>
          <h2 class="h-xl" data-split="lines">{r.t}</h2>
          <p class="lead" data-reveal="up" data-delay=".15">{r.p}</p>
          <ul class="tags" data-stagger=".05">{r.tags.map((x) => <li>{x}</li>)}</ul>
          <div data-reveal="up" data-delay=".25"><a class="btn btn--primary" href={href('/contact/')}>{r.cta} <span class="arrow">→</span></a></div>
        </div>
      </div>
    </section>
  ))}

  <Cta title={s.ctaTitle} />
</Base>

<style>
  .jump { display: flex; flex-wrap: wrap; gap: .6rem; margin-top: 1rem; }
  .jump a { display: inline-flex; align-items: center; gap: .6rem; padding: .6rem 1rem; border-radius: 999px; border: 1px solid rgba(255,255,255,.18); font-size: .85rem; font-weight: 500; transition: background .3s, border-color .3s; min-height: 44px; }
  .jump a span { color: #6fb6ff; font-weight: 700; }
  .jump a:hover { background: rgba(255,255,255,.1); border-color: #fff; }
  .row--flip .row__media { order: 2; }
  .row__media .img-frame { aspect-ratio: 4 / 3; }
  .row__media .img-frame--square { aspect-ratio: 1; }
  .row__media video { width: 100%; height: 100%; object-fit: cover; }
  .row__num { font-size: 3.5rem; font-weight: 800; line-height: .8; color: transparent; -webkit-text-stroke: 1.5px rgba(4,107,210,.4); }
  .row__panel { background: var(--grad); color: #fff; display: grid; place-content: center; gap: .6rem; text-align: center; padding: 2rem; }
  .row__panel span { font-size: .8rem; letter-spacing: .3em; text-transform: uppercase; opacity: .8; }
  .row__panel b { font-size: clamp(2.2rem, 5vw, 3.8rem); font-weight: 800; letter-spacing: -.03em; line-height: 1.05; margin-top: 1rem; text-wrap: balance; }
  .tags { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: .5rem; }
  .tags li { padding: .4rem .8rem; border-radius: 999px; background: rgba(4,107,210,.08); color: var(--blue); font-size: .8rem; font-weight: 600; }
  :global([data-theme="dark"]) .tags li { background: rgba(111,182,255,.14); color: #8fc1ff; }
  @media (max-width: 960px) { .row--flip .row__media { order: 0; } .row__num { font-size: 2.6rem; } }
</style>
