---
import Base from '../layouts/Base.astro';
import Cta from '../components/Cta.astro';

const services = [
  { t: 'Implementation', d: 'Seamless integration of full digital dental ecosystems into your lab or clinic, guided by Fernando Polanco DDT experts.', i: 'M4 6h16v10H4zM2 20h20M9 16v4M15 16v4' },
  { t: 'Cutting-edge technology', d: 'Integrate advanced facial scanning technology and state-of-the-art tools to visualize and plan patient outcomes with superior accuracy.', i: 'M12 3a9 9 0 1 0 9 9M12 3v4M12 3l3 1M12 12l6-6M12 12a2 2 0 1 0 0 .01' },
  { t: 'Training', d: 'Master the digital workflow with hands-on training in intraoral scanning, facial scanning, Exocad design, and 3D printing.', i: 'M3 8l9-4 9 4-9 4zM7 10v5c0 1.5 2.5 3 5 3s5-1.5 5-3v-5M21 8v6' },
  { t: 'Customized workflows', d: 'Tailor-made digital protocols designed specifically for your clinic to maximize efficiency and improve the patient experience.', i: 'M4 6h6v6H4zM14 12h6v6h-6zM10 9h4M17 12V8M7 12v3h7' },
  { t: 'Components', d: 'Premium components engineered to optimize your digital workflows, ensuring better fit and maximum patient comfort.', i: 'M12 2l8 4.5v9L12 20l-8-4.5v-9zM12 20v-9M4 6.5l8 4.5 8-4.5' },
  { t: 'Support', d: 'Reliable, on-demand technical expert support to ensure your digital equipment and software keep running smoothly.', i: 'M4 13a8 8 0 0 1 16 0M4 13v4a2 2 0 0 0 2 2h2v-6H4M20 13v4a2 2 0 0 1-2 2h-2v-6h4M12 21h4' },
];

const pillars = [
  { n: '01', k: 'Design services', h: ['Experience premium', 'design services'], p: 'Elevate your clinical outcomes with our end-to-end digital design solutions. From comprehensive All-on-X planning to highly accurate surgical guides, we deliver uncompromising design quality for every case.', cta: 'See design services', href: '/services', video: '/video/smile-preview.mp4' },
  { n: '02', k: 'Facial scanner', h: ['The next generation of', 'facial scanning'], p: 'Transform your practice with Fernando Polanco’s 5.0 Facial Scanning Technology. Capture high-resolution facial, bite, and denture scans in under 10 seconds, ensuring ultimate patient comfort while saving up to 80% of chair time.', cta: 'Discover the technology', href: '/services#scanning', img: '/img/design-services.webp' },
  { n: '03', k: 'Training & implementation', h: ['Master the digital workflow', 'with hands-on training'], p: 'Don’t just outsource; understand. Join our intensive hands-on courses designed to bridge the gap between clinical dentistry and digital technology. Master intraoral scanning and Exocad workflows in days, not months.', cta: 'Training & courses', href: '/courses', img: '/img/training-main.webp' },
  { n: '04', k: 'Contact support', h: ['Dedicated support for', 'your digital workflow'], p: 'Stay ahead of the curve in an evolving industry. We integrate facial scanning, AI-assisted planning, and automated manufacturing to deliver the most predictable and patient-centered results available today.', cta: 'Contact support', href: '/contact', img: '/img/training.webp' },
];

const reviews = [
  { n: 'Dr. Michael R.', r: 'Implant Specialist', q: 'The hands-on training with Fernando was a complete game-changer for my clinic. I had struggled with Exocad for months, but his method of breaking down complex workflows made it incredibly intuitive. I left the course with the confidence to handle full-arch cases the very next day. Truly the “Wizard” of digital dentistry.' },
  { n: 'Sarah L.', r: 'Dental Lab Owner', q: 'Precision is everything in implantology, and Experts DDT delivers exactly that. The fit of their Zirconia bars and the accuracy of the surgical guides are unmatched. We’ve significantly reduced our chairside adjustment time since we started working with them. A partner you can trust.' },
  { n: 'Dr. James K.', r: 'Prosthodontist', q: 'I brought a nightmare case to Fernando that two other labs had turned down. He didn’t just design a solution; he engineered a workflow that saved the patient’s treatment. His deep understanding of both the clinical and technical sides is rare to find. Highly recommended.' },
];

const keywords = ['Exocad', 'All-on-X', 'Facial scanning', 'Intraoral scanning', '3D printing', 'Photogrammetry', 'CBCT', 'Zirconia', 'Surgical guides', 'PMMA', 'Smile design'];
---
<Base title="The best in dental solutions">

  <!-- ================= HERO + PORTAL CHAPTER (pinned scrub) ================= -->
  <section id="hero" class="hero" data-scene data-nav-solid-from>
    <div class="hero__bg" aria-hidden="true">
      <video autoplay muted loop playsinline preload="metadata" poster="/img/design-services.webp" src="/video/smile-design.mp4"></video>
      <div class="hero__veil"></div>
    </div>
    <div class="hero__glow" aria-hidden="true"><i></i><i></i><i></i></div>
    <div class="grid-bg" aria-hidden="true"></div>
    <div class="hero__ghost" aria-hidden="true"><span class="line-mask"><span class="g1">DIGITAL</span></span><span class="line-mask"><span class="g2">DENTISTRY</span></span></div>

    <div class="hero__stage wrap">
      <div class="hero__copy">
        <p class="hero__eyebrow"><span class="pill">✦ Fernando Polanco DDT · since 2019</span></p>
        <h1 class="hero__title">
          <span class="line-mask"><span class="w">The best in</span></span>
          <span class="line-mask"><span class="w">dental</span> <span class="w accent">solutions.</span></span>
        </h1>
        <p class="hero__lead">Premium design services, facial scanning, hands-on training and expert support. The complete digital workflow, engineered by “The Wizard of Digital Dentistry”.</p>
        <div class="hero__cta cta-row">
          <a class="btn btn--primary" href="/contact" data-magnetic>Book a consultation <span class="arrow">→</span></a>
          <a class="btn btn--ghost" href="https://portal.expertsddt.com/login" target="_blank" rel="noopener">Doctor portal</a>
        </div>
      </div>

      <div class="hero__laptop">
        <img class="float-loop" src="/img/portal-laptop.webp" alt="Experts DDT Doctor Portal dashboard showing clinical cases on a laptop" width="1774" height="887" fetchpriority="high" />
      </div>

      <div class="portal" aria-labelledby="portal-title">
        <div class="portal__head">
          <span class="pill">✦ New</span>
          <h2 id="portal-title">Introducing the Experts DDT Doctor Portal</h2>
          <p>Submit cases, track progress, and communicate with our design team — all in one secure platform.</p>
        </div>
        <ul class="portal__features">
          <li class="portal__feature"><i><svg viewBox="0 0 24 24"><path d="M12 16V4M7 9l5-5 5 5M4 20h16"/></svg></i><h3>Easy case submission</h3><p>Upload scans, photos, and prescriptions in minutes</p></li>
          <li class="portal__feature"><i><svg viewBox="0 0 24 24"><path d="M3 12h4l3-8 4 16 3-8h4"/></svg></i><h3>Real-time tracking</h3><p>Monitor your case status from submission to delivery</p></li>
          <li class="portal__feature"><i><svg viewBox="0 0 24 24"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z"/></svg></i><h3>Direct communication</h3><p>Chat with our designers and get instant updates</p></li>
        </ul>
        <div class="portal__cta cta-row">
          <a class="btn btn--white" href="https://portal.expertsddt.com/signup" target="_blank" rel="noopener">Sign up as doctor</a>
          <a class="btn btn--ghost" href="https://portal.expertsddt.com/login" target="_blank" rel="noopener">Log in <span class="arrow">→</span></a>
        </div>
      </div>
    </div>

    <div class="hero__scroll" aria-hidden="true"><span></span>Scroll</div>
  </section>

  <!-- ================= PILLARS (horizontal scroll) ================= -->
  <section id="pillars" class="pillars" data-scene aria-label="What we do">
    <div class="pillars__hud">
      <span class="eyebrow">What we do</span>
      <span class="pillars__progress" aria-hidden="true"><i></i></span>
      <span class="pillars__count" aria-hidden="true">01</span>
    </div>
    <div class="pillars__track">
      <article class="pillar pillar--intro">
        <div class="pillar__copy">
          <span class="eyebrow">Four pillars</span>
          <h2 class="h-display" data-split="words">Everything a fully digital practice needs.</h2>
          <p class="lead" data-reveal="up" data-delay=".3">Design, scanning, training and support, under one roof and one expert. Keep scrolling to explore each pillar.</p>
          <span class="pillar__hint" data-reveal="up" data-delay=".5">Scroll <span class="arrow">→</span></span>
        </div>
      </article>
      {pillars.map((p) => (
        <article class="pillar">
          <div class="pillar__media" aria-hidden="true">
            {p.video ? <video autoplay muted loop playsinline preload="metadata" src={p.video}></video> : <img src={p.img} alt="" loading="lazy" />}
          </div>
          <div class="pillar__copy">
            <span class="pillar__num">{p.n}</span>
            <span class="eyebrow">{p.k}</span>
            <h3 class="h-xl">{p.h[0]}<br /><span class="accent">{p.h[1]}</span></h3>
            <p class="lead">{p.p}</p>
            <a class="btn btn--primary" href={p.href}>{p.cta} <span class="arrow">→</span></a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- ================= SERVICES GRID ================= -->
  <section id="services" class="section section--mist services" data-scene>
    <img class="services__brush" src="/img/facial-scan.webp" alt="" aria-hidden="true" data-parallax="0.35" loading="lazy" />
    <div class="wrap">
      <div class="services__head" data-reveal-scope>
        <span class="eyebrow" data-reveal="up">Our main</span>
        <h2 class="h-display" data-split="chars"><span class="underline-accent">Services</span></h2>
        <p class="lead" data-reveal="up" data-delay=".2">Six ways we help labs and clinics go fully digital, with predictable, precise and profitable results.</p>
      </div>
      <div class="services__grid" data-stagger=".08">
        {services.map((s) => (
          <article class="svc card card--grad" data-tilt data-glow>
            <i class="svc__icon"><svg viewBox="0 0 24 24"><path d={s.i}/></svg></i>
            <h3>{s.t}</h3>
            <p>{s.d}</p>
            <a href="/services" class="svc__link">Learn more <span class="arrow">→</span></a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ================= MARQUEE + STATS ================= -->
  <section class="stats section--navy" data-scene aria-label="Key numbers">
    <div class="marquee" aria-hidden="true">
      <div class="marquee__track">{keywords.map((k) => <span>{k}<i>✦</i></span>)}</div>
    </div>
    <div class="wrap stats__grid" data-stagger=".1">
      <div class="stat"><strong><span data-count="2019">0</span></strong><span>Founded in Florida, USA</span></div>
      <div class="stat"><strong><span data-count="13">0</span>+</strong><span>Years of daily collaboration with dentists and patients</span></div>
      <div class="stat"><strong>&lt;<span data-count="10">0</span>s</strong><span>To capture a high-resolution facial, bite or denture scan</span></div>
      <div class="stat"><strong><span data-count="80">0</span>%</strong><span>Chair time saved with 5.0 facial scanning technology</span></div>
      <div class="stat"><strong><span data-count="70">0</span>%</strong><span>Less design time with our teeth-in-occlusion libraries</span></div>
    </div>
  </section>

  <!-- ================= ABOUT ================= -->
  <section id="about" class="section about" data-scene>
    <div class="wrap grid-2">
      <div class="about__visual">
        <div class="about__photo" data-reveal="iris">
          <img src="/img/fernando.webp" alt="Fernando Polanco, founder of Experts DDT" width="1024" height="1024" loading="lazy" />
        </div>
        <div class="about__badge" data-reveal="scale" data-delay=".5" data-parallax="0.5">
          <strong>The Wizard</strong><span>of Digital Dentistry</span>
        </div>
        <div class="about__orbit" aria-hidden="true" data-parallax="0.25"></div>
      </div>
      <div class="about__copy" data-reveal-scope>
        <span class="eyebrow" data-reveal="up">About us</span>
        <h2 class="h-xl" data-split="lines">Fernando Polanco <span class="underline-accent">DDT LLC</span></h2>
        <p class="lead about__p" data-lit>Founded in 2019, we provide high-level design services, digital dentistry implementations, hands-on training, and comprehensive clinical and technical support. The company specializes in advanced dental technology solutions, including facial scanning, intraoral scanning, CBCT, and photogrammetry, and in the development of innovative, fully digital workflows that optimize accuracy, efficiency, and patient care.</p>
        <p class="about__p" data-lit>Fernando Polanco, widely known as “The Wizard of Digital Dentistry”, is an immigrant from Guatemala who has earned global recognition for his unique innovations, developments, and contributions to the evolution of digital dentistry. With over 13 years of daily collaboration with dentists and patients, Fernando has built exceptional expertise and a deep understanding of clinical needs, allowing him to create cutting-edge solutions that elevate the standard of care across the industry.</p>
        <div class="cta-row" data-reveal="up">
          <a class="btn btn--primary" href="/contact">Work with Fernando <span class="arrow">→</span></a>
          <a class="btn btn--outline" href="/courses">Explore courses</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= REVIEWS (card stack) ================= -->
  <section id="reviews" class="section section--mist reviews" data-scene>
    <div class="wrap reviews__grid">
      <div class="reviews__head" data-reveal-scope>
        <span class="eyebrow" data-reveal="up">Your reviews</span>
        <h2 class="h-display" data-split="lines">Let us know<br />how you <span class="underline-accent">feel</span></h2>
        <p class="lead" data-reveal="up" data-delay=".2">Specialists, prosthodontists and lab owners on what changes when Experts DDT joins the workflow.</p>
        <div class="reviews__rating" data-reveal="up" data-delay=".35"><span class="stars" aria-hidden="true">★★★★★</span> Trusted by clinics and labs across the US</div>
      </div>
      <div class="reviews__stack">
        {reviews.map((r, i) => (
          <figure class="stack-card card" style={`--i:${i}`}>
            <span class="stack-card__quote" aria-hidden="true">“</span>
            <blockquote><p>{r.q}</p></blockquote>
            <figcaption><strong>{r.n}</strong><span>{r.r}</span><span class="stars" aria-hidden="true">★★★★★</span></figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- ================= RESOURCES ================= -->
  <section id="resources" class="section resources" data-scene>
    <div class="wrap">
      <div class="resources__head" data-reveal-scope>
        <span class="eyebrow" data-reveal="up">Learn, download, upgrade</span>
        <h2 class="h-xl" data-split="words">Resources built for your <span class="underline-accent">Exocad workflow</span></h2>
      </div>
      <div class="grid-3 resources__grid">
        <a class="res res--free" href="/libraries" data-reveal="drop">
          <span class="pill">Free download</span>
          <h3>ExpertsDDT implant libraries</h3>
          <p>Manufacturer-ready implant components for accurate restorations across major systems. Ready to import into Exocad.</p>
          <span class="res__cta">Download <span class="arrow">→</span></span>
        </a>
        <a class="res res--course" href="/courses" data-reveal="drop" data-delay=".12">
          <span class="pill">Online course · Sale</span>
          <h3>Teeth & virtual gingiva libraries in Exocad</h3>
          <p>Video training on how to use the teeth and virtual gingiva libraries, at your own pace.</p>
          <span class="price"><s>$149.99</s>$99.99</span>
          <span class="res__cta">Join today <span class="arrow">→</span></span>
        </a>
        <a class="res res--store" href="/store" data-reveal="drop" data-delay=".24">
          <span class="pill">Templates · Sale</span>
          <h3>Teeth in occlusion with virtual gingiva</h3>
          <p>Pre-occluded tooth libraries by Fernando Polanco. Save up to 70% of design time on dentures, overdentures and All-on-X.</p>
          <span class="price"><s>$699.99</s>$399.99</span>
          <span class="res__cta">Visit the store <span class="arrow">→</span></span>
        </a>
      </div>
    </div>
  </section>

  <Cta />
</Base>

<style>
  /* ---------- HERO ---------- */
  .hero { position: relative; min-height: 100vh; min-height: 100svh; color: #fff; overflow: hidden; isolation: isolate; display: flex; align-items: center; }
  .hero__bg { position: absolute; inset: 0; z-index: -3; }
  .hero__bg video { width: 100%; height: 100%; object-fit: cover; }
  .hero__veil { position: absolute; inset: 0; background: linear-gradient(110deg, rgba(10,26,58,.96) 0%, rgba(15,52,110,.85) 45%, rgba(4,107,210,.35) 100%), linear-gradient(0deg, rgba(10,26,58,.9), transparent 40%); }
  .hero__glow { position: absolute; inset: 0; z-index: -2; pointer-events: none; }
  .hero__glow i { position: absolute; border-radius: 50%; filter: blur(70px); opacity: .55; animation: drift 14s ease-in-out infinite alternate; }
  .hero__glow i:nth-child(1) { width: 46vw; height: 46vw; left: -12vw; top: -10vw; background: #046bd2; }
  .hero__glow i:nth-child(2) { width: 34vw; height: 34vw; right: -8vw; top: 10vh; background: #2a7abf; animation-delay: -5s; }
  .hero__glow i:nth-child(3) { width: 30vw; height: 30vw; left: 30vw; bottom: -14vw; background: #1d3273; animation-delay: -9s; }
  @keyframes drift { from { transform: translate(0,0) scale(1) } to { transform: translate(6vw, 4vh) scale(1.12) } }
  .hero .grid-bg { z-index: -1; opacity: .5; }
  .hero__ghost { position: absolute; right: 2vw; top: 8vh; z-index: -1; display: grid; text-align: right; font-size: clamp(4rem, 9.5vw, 9rem); font-weight: 800; line-height: .9; letter-spacing: -.04em; color: transparent; -webkit-text-stroke: 1px rgba(255,255,255,.12); pointer-events: none; user-select: none; }
  .hero__ghost span span { display: block; }
  .hero__stage { position: relative; display: grid; grid-template-columns: 1.05fr .95fr; gap: 2rem; align-items: center; padding-top: var(--nav-h); min-height: 100vh; }
  .hero__copy { position: relative; z-index: 2; max-width: 620px; }
  .hero__eyebrow { margin-bottom: 1.4rem; }
  .hero__title { font-size: clamp(2.8rem, 6.4vw, 5.4rem); font-weight: 800; color: #fff; line-height: 1.02; letter-spacing: -.03em; }
  .hero__title .line-mask { padding-bottom: .08em; }
  .hero__title .w { display: inline-block; }
  .hero__title .accent { color: #6fb6ff; }
  .hero__lead { margin: 1.6rem 0 2.2rem; font-size: clamp(1rem, 1.35vw, 1.2rem); color: #c7d6ee; max-width: 52ch; }
  .hero__laptop { position: relative; z-index: 1; filter: drop-shadow(0 40px 60px rgba(0,0,0,.55)); }
  .hero__laptop img { width: 100%; height: auto; }
  .hero__scroll { position: absolute; left: 50%; bottom: 1.6rem; transform: translateX(-50%); font-size: .7rem; letter-spacing: .3em; text-transform: uppercase; color: #9fb3d4; display: grid; justify-items: center; gap: .5rem; }
  .hero__scroll span { width: 1px; height: 46px; background: linear-gradient(#fff, transparent); animation: scrollHint 1.8s ease-in-out infinite; transform-origin: top; }
  @keyframes scrollHint { 0% { transform: scaleY(0); opacity: 0 } 40% { transform: scaleY(1); opacity: 1 } 100% { transform: scaleY(1) translateY(20px); opacity: 0 } }

  /* portal chapter: absolute over the stage on desktop, normal flow on mobile */
  .portal { text-align: center; color: #c7d6ee; }
  .portal__head { max-width: 760px; margin-inline: auto; display: grid; gap: .8rem; justify-items: center; }
  .portal__head h2 { color: #fff; font-size: clamp(1.8rem, 3.6vw, 2.9rem); font-weight: 800; }
  .portal__head p { max-width: 56ch; }
  .portal__features { list-style: none; padding: 0; margin: 2rem auto 1.6rem; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; max-width: 980px; }
  .portal__feature { background: rgba(255,255,255,.07); border: 1px solid rgba(255,255,255,.14); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border-radius: 18px; padding: 1.2rem 1.3rem; text-align: left; display: grid; grid-template-columns: 44px 1fr; gap: .2rem .9rem; align-items: center; }
  .portal__feature i { grid-row: span 2; width: 44px; height: 44px; border-radius: 12px; background: var(--grad-blue); display: grid; place-items: center; }
  .portal__feature svg { width: 22px; height: 22px; fill: none; stroke: #fff; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .portal__feature h3 { color: #fff; font-size: 1rem; font-weight: 700; }
  .portal__feature p { font-size: .85rem; color: #b9c8e2; }
  .portal__cta { justify-content: center; }
  @media (min-width: 961px) {
    .portal { position: absolute; inset: 0; z-index: 3; padding-top: calc(var(--nav-h) + 1vh); pointer-events: none; }
    .portal__head, .portal__features, .portal__cta { pointer-events: auto; }
    .hero__laptop { position: absolute; left: 0; right: 0; margin-inline: auto; top: 59vh; width: min(66vw, 1040px); z-index: 2; }
    .hero__stage { grid-template-columns: 1fr; }
    .hero__copy { max-width: 640px; }
  }
  @media (max-width: 960px) {
    .hero { padding-bottom: 4rem; }
    .hero__stage { grid-template-columns: 1fr; padding-top: calc(var(--nav-h) + 3rem); gap: 3rem; }
    .hero__laptop { margin-inline: -1rem; }
    .portal { padding-top: 2rem; }
    .portal__features { grid-template-columns: 1fr; }
    .hero__scroll, .hero__ghost { display: none; }
  }

  /* ---------- PILLARS ---------- */
  .pillars { position: relative; background: #fff; overflow: hidden; }
  .pillars__hud { position: absolute; top: calc(var(--nav-h) + .8rem); left: 50%; transform: translateX(-50%); width: min(1200px, 100% - 2rem); display: flex; align-items: center; gap: 1.2rem; z-index: 5; }
  .pillars__progress { flex: 1; height: 2px; background: rgba(29,50,115,.12); border-radius: 2px; overflow: hidden; }
  .pillars__progress i { display: block; height: 100%; background: var(--blue); transform: scaleX(0); transform-origin: left; }
  .pillars__count { font-weight: 700; font-variant-numeric: tabular-nums; color: var(--ink); }
  .pillars__track { display: flex; height: 100vh; width: max-content; }
  .pillar { width: 100vw; height: 100vh; flex: 0 0 auto; display: grid; grid-template-columns: 1fr 1fr; align-items: center; padding: calc(var(--nav-h) + 3rem) clamp(1rem, 6vw, 6rem) 3rem; gap: 3rem; position: relative; }
  .pillar--intro { grid-template-columns: 1fr; background: var(--mist); }
  .pillar--intro .pillar__copy { max-width: 820px; }
  .pillar__hint { font-size: .8rem; letter-spacing: .2em; text-transform: uppercase; color: var(--blue); font-weight: 600; display: inline-flex; gap: .6rem; }
  .pillar__hint .arrow { animation: nudge 1.4s ease-in-out infinite; display: inline-block; }
  @keyframes nudge { 50% { transform: translateX(6px) } }
  .pillar__media { position: relative; height: min(70vh, 640px); border-radius: 28px; overflow: hidden; box-shadow: 0 40px 80px -40px rgba(15,52,110,.55); background: var(--mist); }
  .pillar__media > * { width: 100%; height: 100%; object-fit: cover; }
  .pillar__media::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 60%, rgba(15,52,110,.35)); }
  .pillar__copy { display: grid; gap: 1.2rem; justify-items: start; }
  .pillar__num { font-size: clamp(4rem, 9vw, 7rem); font-weight: 800; line-height: .8; color: transparent; -webkit-text-stroke: 1.5px rgba(4,107,210,.35); letter-spacing: -.04em; }
  .pillars.is-static .pillars__hud { display: none; }
  .pillars.is-static .pillars__track { flex-direction: column; height: auto; width: 100%; }
  .pillars.is-static .pillar { width: 100%; height: auto; grid-template-columns: 1fr; padding: 4rem 1rem; }
  .pillars.is-static .pillar__media { height: 48vh; }
