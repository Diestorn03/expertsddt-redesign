---
import Base from '../layouts/Base.astro';
import Cta from '../components/Cta.astro';
import { useI18n } from '../i18n/index.js';
const { t, href, asset } = useI18n(Astro);
const shop = import.meta.env.PUBLIC_SHOP_URL;

const icons = [
  'M4 6h16v10H4zM2 20h20M9 16v4M15 16v4',
  'M12 3a9 9 0 1 0 9 9M12 3v4M12 3l3 1M12 12l6-6M12 12a2 2 0 1 0 0 .01',
  'M3 8l9-4 9 4-9 4zM7 10v5c0 1.5 2.5 3 5 3s5-1.5 5-3v-5M21 8v6',
  'M4 6h6v6H4zM14 12h6v6h-6zM10 9h4M17 12V8M7 12v3h7',
  'M12 2l8 4.5v9L12 20l-8-4.5v-9zM12 20v-9M4 6.5l8 4.5 8-4.5',
  'M4 13a8 8 0 0 1 16 0M4 13v4a2 2 0 0 0 2 2h2v-6H4M20 13v4a2 2 0 0 1-2 2h-2v-6h4M12 21h4',
];
const featureIcons = ['M12 16V4M7 9l5-5 5 5M4 20h16', 'M3 12h4l3-8 4 16 3-8h4', 'M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z'];
const pillarMedia = [{ video: asset('/video/smile-preview.mp4') }, { img: asset('/img/design-services.webp') }, { img: asset('/img/training-main.webp') }, { img: asset('/img/training.webp') }];
---
<Base title={t.meta.home}>

  <!-- ================= HERO + PORTAL CHAPTER (pinned scrub on desktop) ================= -->
  <section id="hero" class="hero" data-scene data-nav-solid-from>
    <div class="hero__bg" aria-hidden="true">
      <video class="hero__video" autoplay muted loop playsinline preload="metadata" poster={asset('/img/design-services.webp')} src={asset('/video/smile-design.mp4')}></video>
      <img class="hero__poster" src={asset('/img/design-services.webp')} alt="" loading="eager" />
      <div class="hero__veil"></div>
    </div>
    <div class="hero__glow" aria-hidden="true"><i></i><i></i><i></i></div>
    <div class="grid-bg" aria-hidden="true"></div>
    <div class="hero__ghost" aria-hidden="true"><span class="line-mask"><span class="g1">{t.hero.ghost[0]}</span></span><span class="line-mask"><span class="g2">{t.hero.ghost[1]}</span></span></div>

    <div class="hero__stage wrap">
      <div class="hero__copy">
        <p class="hero__eyebrow"><span class="pill">{t.hero.eyebrow}</span></p>
        <h1 class="hero__title">
          <span class="line-mask"><span class="w">{t.hero.title[0]}</span></span>
          <span class="line-mask"><span class="w">{t.hero.title[1]}</span> <span class="w accent">{t.hero.title[2]}</span></span>
        </h1>
        <p class="hero__lead">{t.hero.lead}</p>
        <div class="hero__cta cta-row">
          <a class="btn btn--primary" href={href('/contact/')} data-magnetic>{t.hero.cta} <span class="arrow">→</span></a>
          <a class="btn btn--ghost" href="https://portal.expertsddt.com/login" target="_blank" rel="noopener">{t.hero.portal}</a>
        </div>
      </div>

      <div class="hero__laptop">
        <img class="float-loop" src={asset('/img/portal-laptop.webp')} alt={t.hero.laptopAlt} width="1774" height="887" fetchpriority="high" />
      </div>

      <div class="portal" aria-labelledby="portal-title">
        <div class="portal__head">
          <span class="pill">{t.portal.pill}</span>
          <h2 id="portal-title">{t.portal.title}</h2>
          <p>{t.portal.text}</p>
        </div>
        <ul class="portal__features">
          {t.portal.features.map((f, i) => (
            <li class="portal__feature"><i><svg viewBox="0 0 24 24"><path d={featureIcons[i]}/></svg></i><h3>{f.t}</h3><p>{f.d}</p></li>
          ))}
        </ul>
        <div class="portal__cta cta-row">
          <a class="btn btn--white" href="https://portal.expertsddt.com/signup" target="_blank" rel="noopener">{t.portal.signup}</a>
          <a class="btn btn--ghost" href="https://portal.expertsddt.com/login" target="_blank" rel="noopener">{t.portal.login} <span class="arrow">→</span></a>
        </div>
      </div>
    </div>

    <div class="hero__scroll" aria-hidden="true"><span></span>{t.hero.scroll}</div>
  </section>

  <!-- ================= PILLARS (horizontal scroll on desktop) ================= -->
  <section id="pillars" class="pillars" data-scene aria-label={t.pillars.hud}>
    <div class="pillars__hud">
      <span class="eyebrow">{t.pillars.hud}</span>
      <span class="pillars__progress" aria-hidden="true"><i></i></span>
      <span class="pillars__count" aria-hidden="true">01</span>
    </div>
    <div class="pillars__track">
      <article class="pillar pillar--intro">
        <div class="pillar__copy">
          <span class="eyebrow">{t.pillars.intro.eyebrow}</span>
          <h2 class="h-display" data-split="words">{t.pillars.intro.title}</h2>
          <p class="lead" data-reveal="up" data-delay=".3">{t.pillars.intro.lead}</p>
          <span class="pillar__hint" data-reveal="up" data-delay=".5">{t.pillars.intro.hint} <span class="arrow">→</span></span>
        </div>
      </article>
      {t.pillars.items.map((p, i) => (
        <article class="pillar">
          <div class="pillar__media" aria-hidden="true">
            {pillarMedia[i].video ? <video autoplay muted loop playsinline preload="metadata" src={pillarMedia[i].video}></video> : <img src={pillarMedia[i].img} alt="" loading="lazy" />}
          </div>
          <div class="pillar__copy">
            <span class="pillar__num">{p.n}</span>
            <span class="eyebrow">{p.k}</span>
            <h3 class="h-xl">{p.h[0]}<br /><span class="accent">{p.h[1]}</span></h3>
            <p class="lead">{p.p}</p>
            <a class="btn btn--primary" href={href(p.href)}>{p.cta} <span class="arrow">→</span></a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- ================= SERVICES GRID ================= -->
  <section id="services" class="section section--mist services" data-scene>
    <img class="services__brush" src={asset('/img/facial-scan.webp')} alt="" aria-hidden="true" data-parallax="0.35" loading="lazy" />
    <div class="wrap">
      <div class="services__head" data-reveal-scope>
        <span class="eyebrow" data-reveal="up">{t.services.eyebrow}</span>
        <h2 class="h-display" data-split="chars"><span class="underline-accent">{t.services.title}</span></h2>
        <p class="lead" data-reveal="up" data-delay=".2">{t.services.lead}</p>
      </div>
      <div class="services__grid" data-stagger=".08">
        {t.services.items.map((s, i) => (
          <article class="svc card card--grad" data-tilt data-glow>
            <i class="svc__icon"><svg viewBox="0 0 24 24"><path d={icons[i]}/></svg></i>
            <h3>{s.t}</h3>
            <p>{s.d}</p>
            <a href={href('/services/')} class="svc__link">{t.services.learn} <span class="arrow">→</span></a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ================= MARQUEE + STATS ================= -->
  <section class="stats section--navy" data-scene aria-label="Key numbers">
    <div class="marquee" aria-hidden="true">
      <div class="marquee__track">{t.stats.keywords.map((k) => <span>{k}<i>✦</i></span>)}</div>
    </div>
    <div class="wrap stats__grid" data-stagger=".1">
      {t.stats.items.map((s) => (
        <div class="stat"><strong>{s.prefix}<span data-count={s.v}>0</span>{s.suffix}</strong><span>{s.label}</span></div>
      ))}
    </div>
  </section>

  <!-- ================= ABOUT ================= -->
  <section id="about" class="section about" data-scene>
    <div class="wrap grid-2">
      <div class="about__visual">
        <div class="about__photo" data-reveal="iris">
          <img src={asset('/img/fernando.webp')} alt={t.about.photoAlt} width="1024" height="1024" loading="lazy" />
        </div>
        <div class="about__badge" data-reveal="scale" data-delay=".5" data-parallax="0.5">
          <strong>{t.about.badge}</strong><span>{t.about.badgeSub}</span>
        </div>
        <div class="about__orbit" aria-hidden="true" data-parallax="0.25"></div>
      </div>
      <div class="about__copy" data-reveal-scope>
        <span class="eyebrow" data-reveal="up">{t.about.eyebrow}</span>
        <h2 class="h-xl" data-split="lines">{t.about.title} <span class="underline-accent">{t.about.titleAccent}</span></h2>
        <p class="lead about__p" data-lit>{t.about.p1}</p>
        <p class="about__p" data-lit>{t.about.p2}</p>
        <div class="cta-row" data-reveal="up">
          <a class="btn btn--primary" href={href('/contact/')}>{t.about.cta} <span class="arrow">→</span></a>
          <a class="btn btn--outline" href={href('/courses/')}>{t.about.cta2}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= REVIEWS (card stack) ================= -->
  <section id="reviews" class="section section--mist reviews" data-scene>
    <div class="wrap reviews__grid">
      <div class="reviews__head" data-reveal-scope>
        <span class="eyebrow" data-reveal="up">{t.reviews.eyebrow}</span>
        <h2 class="h-display" data-split="lines">{t.reviews.title}<br />{t.reviews.titleLine2} <span class="underline-accent">{t.reviews.titleAccent}</span></h2>
        <p class="lead" data-reveal="up" data-delay=".2">{t.reviews.lead}</p>
        <div class="reviews__rating" data-reveal="up" data-delay=".35"><span class="stars" aria-hidden="true">★★★★★</span> {t.reviews.trust}</div>
        <p class="note" data-reveal="up" data-delay=".45">{t.reviews.sample}</p>
      </div>
      <div class="reviews__stack">
        {t.reviews.items.map((r, i) => (
          <figure class="stack-card card" style={`--i:${i}`}>
            <span class="stack-card__quote" aria-hidden="true">“</span>
            <blockquote><p>{r.q}</p></blockquote>
            <figcaption><strong>{r.n}</strong><span>{r.r}</span><span class="stars" aria-hidden="true">★★★★★</span></figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- ================= RESOURCES ================= -->
  <section id="resources" class="section resources" data-scene>
    <div class="wrap">
      <div class="resources__head" data-reveal-scope>
        <span class="eyebrow" data-reveal="up">{t.resources.eyebrow}</span>
        <h2 class="h-xl" data-split="words">{t.resources.title} <span class="underline-accent">{t.resources.titleAccent}</span></h2>
      </div>
      <div class="grid-3 resources__grid">
        <a class="res res--free" href={href('/exocad-libraries/')} data-reveal="drop">
          <span class="pill">{t.resources.free.pill}</span>
          <h3>{t.resources.free.t}</h3>
          <p>{t.resources.free.d}</p>
          <span class="res__cta">{t.resources.free.cta} <span class="arrow">→</span></span>
        </a>
        <a class="res res--course" href={shop || href('/courses/')} data-reveal="drop" data-delay=".12">
          <span class="pill">{t.resources.course.pill}</span>
          <h3>{t.resources.course.t}</h3>
          <p>{t.resources.course.d}</p>
          <span class="price"><s>{t.resources.course.was}</s>{t.resources.course.now}</span>
          <span class="res__cta">{t.resources.course.cta} <span class="arrow">→</span></span>
        </a>
        <a class="res res--store" href={shop || href('/store/')} data-reveal="drop" data-delay=".24">
          <span class="pill">{t.resources.store.pill}</span>
          <h3>{t.resources.store.t}</h3>
          <p>{t.resources.store.d}</p>
          <span class="price"><s>{t.resources.store.was}</s>{t.resources.store.now}</span>
          <span class="res__cta">{t.resources.store.cta} <span class="arrow">→</span></span>
        </a>
      </div>
    </div>
  </section>

  <Cta />
</Base>

<style>
  /* ---------- HERO ---------- */
  .hero { position: relative; min-height: 100vh; min-height: 100svh; color: #fff; overflow: hidden; isolation: isolate; display: flex; align-items: center; background: #0a1a3a; }
  .hero__bg { position: absolute; inset: 0; z-index: -3; }
  .hero__bg video, .hero__poster { width: 100%; height: 100%; object-fit: cover; }
  .hero__poster { display: none; position: absolute; inset: 0; }
  .hero__veil { position: absolute; inset: 0; background: linear-gradient(110deg, rgba(10,26,58,.96) 0%, rgba(15,52,110,.85) 45%, rgba(4,107,210,.35) 100%), linear-gradient(0deg, rgba(10,26,58,.9), transparent 40%); }
  .hero__glow { position: absolute; inset: 0; z-index: -2; pointer-events: none; }
  .hero__glow i { position: absolute; border-radius: 50%; filter: blur(70px); opacity: .55; animation: drift 14s ease-in-out infinite alternate; }
  .hero__glow i:nth-child(1) { width: 46vw; height: 46vw; left: -12vw; top: -10vw; background: #046bd2; }
  .hero__glow i:nth-child(2) { width: 34vw; height: 34vw; right: -8vw; top: 10vh; background: #2a7abf; animation-delay: -5s; }
  .hero__glow i:nth-child(3) { width: 30vw; height: 30vw; left: 30vw; bottom: -14vw; background: #1d3273; animation-delay: -9s; }
  @keyframes drift { from { transform: translate(0,0) scale(1) } to { transform: translate(6vw, 4vh) scale(1.12) } }
  .hero .grid-bg { z-index: -1; opacity: .5; }
  .hero__ghost { position: absolute; right: 2vw; top: 8vh; z-index: -1; display: grid; text-align: right; font-size: clamp(4rem, 9.5vw, 9rem); font-weight: 800; line-height: .9; letter-spacing: -.04em; color: transparent; -webkit-text-stroke: 1px rgba(255,255,255,.12); pointer-events: none; user-select: none; }
  .hero__ghost span span { display: block; }
  .hero__stage { position: relative; display: grid; grid-template-columns: 1fr; gap: 2rem; align-items: center; padding-top: var(--nav-h); min-height: 100vh; }
  .hero__copy { position: relative; z-index: 2; max-width: 640px; }
  .hero__eyebrow { margin-bottom: 1.4rem; }
  .hero__title { font-size: clamp(2.6rem, 6.4vw, 5.4rem); font-weight: 800; color: #fff; line-height: 1.02; letter-spacing: -.03em; }
  .hero__title .line-mask { padding-bottom: .08em; }
  .hero__title .w { display: inline-block; }
  .hero__title .accent { color: #6fb6ff; }
  .hero__lead { margin: 1.6rem 0 2.2rem; font-size: clamp(1rem, 1.35vw, 1.2rem); color: #c7d6ee; max-width: 52ch; }
  .hero__laptop { position: relative; z-index: 1; filter: drop-shadow(0 40px 60px rgba(0,0,0,.55)); }
  .hero__laptop img { width: 100%; height: auto; }
  .hero__scroll { position: absolute; left: 50%; bottom: 1.6rem; transform: translateX(-50%); font-size: .7rem; letter-spacing: .3em; text-transform: uppercase; color: #9fb3d4; display: grid; justify-items: center; gap: .5rem; }
  .hero__scroll span { width: 1px; height: 46px; background: linear-gradient(#fff, transparent); animation: scrollHint 1.8s ease-in-out infinite; transform-origin: top; }
  @keyframes scrollHint { 0% { transform: scaleY(0); opacity: 0 } 40% { transform: scaleY(1); opacity: 1 } 100% { transform: scaleY(1) translateY(20px); opacity: 0 } }

  /* portal chapter: absolute over the stage on desktop, normal flow on mobile */
  .portal { text-align: center; color: #c7d6ee; }
  .portal__head { max-width: 760px; margin-inline: auto; display: grid; gap: .8rem; justify-items: center; }
  .portal__head h2 { color: #fff; font-size: clamp(1.7rem, 3.6vw, 2.9rem); font-weight: 800; }
  .portal__head p { max-width: 56ch; }
  .portal__features { list-style: none; padding: 0; margin: 2rem auto 1.6rem; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; max-width: 980px; }
  .portal__feature { background: rgba(255,255,255,.07); border: 1px solid rgba(255,255,255,.14); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border-radius: 18px; padding: 1.2rem 1.3rem; text-align: left; display: grid; grid-template-columns: 44px 1fr; gap: .2rem .9rem; align-items: center; }
  .portal__feature i { grid-row: span 2; width: 44px; height: 44px; border-radius: 12px; background: var(--grad-blue); display: grid; place-items: center; }
  .portal__feature svg { width: 22px; height: 22px; fill: none; stroke: #fff; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .portal__feature h3 { color: #fff; font-size: 1rem; font-weight: 700; }
  .portal__feature p { font-size: .85rem; color: #b9c8e2; }
  .portal__cta { justify-content: center; }
  @media (min-width: 1181px) {
    .portal { position: absolute; inset: 0; z-index: 3; padding-top: calc(var(--nav-h) + 1vh); pointer-events: none; }
    .portal__head, .portal__features, .portal__cta { pointer-events: auto; }
    .hero__laptop { position: absolute; left: 0; right: 0; margin-inline: auto; top: 59vh; width: min(66vw, 1040px); z-index: 2; }
  }
  @media (max-width: 1180px) {
    .hero { padding-bottom: 3rem; }
    .hero__bg video { display: none; }
    .hero__poster { display: block; }
    .hero__glow i { filter: blur(40px); }
    .hero__glow i:nth-child(3) { display: none; }
    .hero__stage { padding-top: calc(var(--nav-h) + 2.5rem); gap: 2.5rem; }
    .hero__eyebrow { margin-bottom: 1rem; }
    .hero__lead { margin: 1.2rem 0 1.6rem; }
    .hero__laptop { margin-inline: -.5rem; }
    .portal { padding-top: 1rem; }
    .portal__features { grid-template-columns: 1fr; margin: 1.5rem auto 1.2rem; }
    .portal__feature { backdrop-filter: none; -webkit-backdrop-filter: none; background: rgba(255,255,255,.09); }
    .hero__scroll, .hero__ghost { display: none; }
  }

  /* ---------- PILLARS ---------- */
  .pillars { position: relative; background: var(--surface); overflow: hidden; }
  .pillars__hud { position: absolute; top: calc(var(--nav-h) + .8rem); left: 50%; transform: translateX(-50%); width: min(1200px, 100% - 2rem); display: flex; align-items: center; gap: 1.2rem; z-index: 5; }
  .pillars__progress { flex: 1; height: 2px; background: rgba(29,50,115,.12); border-radius: 2px; overflow: hidden; }
  .pillars__progress i { display: block; height: 100%; background: var(--blue); transform: scaleX(0); transform-origin: left; }
  .pillars__count { font-weight: 700; font-variant-numeric: tabular-nums; color: var(--ink); }
  .pillars__track { display: flex; height: 100vh; width: max-content; }
  .pillar { width: 100vw; height: 100vh; flex: 0 0 auto; display: grid; grid-template-columns: 1fr 1fr; align-items: center; padding: calc(var(--nav-h) + 3rem) clamp(1rem, 6vw, 6rem) 3rem; gap: 3rem; position: relative; }
  .pillar--intro { grid-template-columns: 1fr; background: var(--mist); }
  .pillar--intro .pillar__copy { max-width: 820px; }
  .pillar__hint { font-size: .8rem; letter-spacing: .2em; text-transform: uppercase; color: var(--blue); font-weight: 600; display: inline-flex; gap: .6rem; }
  .pillar__hint .arrow { animation: nudge 1.4s ease-in-out infinite; display: inline-block; }
  @keyframes nudge { 50% { transform: translateX(6px) } }
  .pillar__media { position: relative; height: min(70vh, 640px); border-radius: 28px; overflow: hidden; box-shadow: 0 40px 80px -40px rgba(15,52,110,.55); background: var(--mist); }
  .pillar__media > * { width: 100%; height: 100%; object-fit: cover; }
  .pillar__media::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 60%, rgba(15,52,110,.35)); }
  .pillar__copy { display: grid; gap: 1.2rem; justify-items: start; }
  .pillar__num { font-size: clamp(3.5rem, 9vw, 7rem); font-weight: 800; line-height: .8; color: transparent; -webkit-text-stroke: 1.5px rgba(4,107,210,.35); letter-spacing: -.04em; }
  .pillars.is-static .pillars__hud { display: none; }
  .pillars.is-static .pillars__track { flex-direction: column; height: auto; width: 100%; }
  .pillars.is-static .pillar { width: 100%; height: auto; grid-template-columns: 1fr; padding: 3.5rem 1.25rem; gap: 1.5rem; }
  .pillars.is-static .pillar--intro { padding-block: 4rem; }
  .pillars.is-static .pillar__media { height: auto; aspect-ratio: 4 / 3; border-radius: 18px; }
  .pillars.is-static .pillar__hint { display: none; }
  .pillars.is-static .pillar__copy { gap: .9rem; }
  .pillars.is-static .pillar__num { font-size: 3rem; }
  .pillars.is-static .pillar__copy h3 br { display: none; }
  .pillars.is-static .pillar__copy h3 .accent { display: inline; }
  .pillars.is-static .pillar__copy h3 .accent::before { content: ' '; }

  /* ---------- SERVICES ---------- */
  .services { overflow: hidden; }
  .services__brush { position: absolute; left: 50%; top: 2rem; width: min(900px, 120vw); transform: translateX(-50%); opacity: .8; pointer-events: none; z-index: 0; }
  :global([data-theme="dark"]) .services__brush { opacity: .12; }
  .services__head { position: relative; text-align: center; display: grid; justify-items: center; gap: 1rem; margin-bottom: 3rem; z-index: 1; }
  .services__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; position: relative; z-index: 1; }
  .svc { position: relative; overflow: hidden; display: grid; gap: .9rem; align-content: start; min-height: 300px; transition: box-shadow .4s; }
  .svc::before { content: ''; position: absolute; inset: 0; background: radial-gradient(240px circle at var(--gx, 50%) var(--gy, 50%), rgba(255,255,255,.18), transparent 60%); opacity: 0; transition: opacity .4s; pointer-events: none; }
  .svc:hover::before { opacity: 1; }
  .svc:hover { box-shadow: 0 30px 60px -24px rgba(29,50,115,.6); }
  .svc__icon { width: 54px; height: 54px; border-radius: 16px; background: rgba(255,255,255,.12); border: 1px solid rgba(255,255,255,.2); display: grid; place-items: center; }
  .svc__icon svg { width: 26px; height: 26px; fill: none; stroke: #fff; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .svc h3 { font-size: 1.2rem; text-transform: uppercase; letter-spacing: .04em; }
  .svc p { font-size: .95rem; }
  .svc__link { margin-top: auto; font-weight: 600; color: #fff; display: inline-flex; gap: .4rem; align-items: center; min-height: 44px; }
  .svc__link:hover .arrow { transform: translateX(4px); }
