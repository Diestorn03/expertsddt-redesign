---
// Floating actions: WhatsApp + "Apex" concierge.
// With PUBLIC_N8N_CHAT_WEBHOOK the official @n8n/chat widget is mounted; otherwise the button links to contact.
import { useI18n } from '../i18n/index.js';
const { t, href, lang } = useI18n(Astro);
const chat = import.meta.env.PUBLIC_N8N_CHAT_WEBHOOK;
const wa = import.meta.env.PUBLIC_WHATSAPP || '15106760418';
const waText = lang === 'es' ? 'Hola, me interesa saber más sobre los servicios de Experts DDT.' : 'Hi, I would like to know more about Experts DDT services.';
---
<div class="floats">
  <a class="wa" href={`https://wa.me/${wa}?text=${encodeURIComponent(waText)}`} target="_blank" rel="noopener" aria-label={t.nav.whatsapp}>
    <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.6.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.8 12 12 0 0 0 4.6 4.1c1.7.7 2.4.8 3.2.7a2.7 2.7 0 0 0 1.8-1.3 2.2 2.2 0 0 0 .2-1.3c-.1-.1-.3-.2-.5-.3z"/></svg>
    <span>WhatsApp</span>
  </a>
  {!chat && (
    <a class="fab" href={href('/contact/')} aria-label={t.nav.apexLabel}>
      <span class="fab__dot"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z"/></svg></span>
      {t.nav.apex}
    </a>
  )}
</div>
{chat && (
  <>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@n8n/chat/dist/style.css" />
    <script type="module" is:inline define:vars={{ chat, lang }}>
      import { createChat } from 'https://cdn.jsdelivr.net/npm/@n8n/chat/dist/chat.bundle.es.js';
      const es = lang === 'es';
      createChat({
        webhookUrl: chat, mode: 'window', loadPreviousSession: true,
        initialMessages: es ? ['Hola, soy Apex, tu concierge digital de Experts DDT. ¿En qué puedo ayudarte?'] : ['Welcome to Experts DDT. I am Apex, your Digital Concierge. How may I guide you through our services or workflows today?'],
        i18n: { en: { title: 'Apex · Experts DDT', subtitle: es ? 'Soporte técnico y guía de servicios' : 'Technical Support & Service Guide', footer: '', getStarted: es ? 'Nueva conversación' : 'New conversation', inputPlaceholder: es ? 'Escribe tu pregunta…' : 'Type your question…' } },
      });
    </script>
  </>
)}
