{
  "trailingSlash": true,
  "redirects": [
    { "source": "/libraries", "destination": "/exocad-libraries/", "permanent": true },
    { "source": "/libraries/", "destination": "/exocad-libraries/", "permanent": true },
    { "source": "/carrito/", "destination": "/store/", "permanent": true },
    { "source": "/shop/", "destination": "/store/", "permanent": true }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
    ] },
    { "source": "/(img|video|_astro)/(.*)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" } ] }
  ]
}
